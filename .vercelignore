# Vercel Hobby caps a deployment at 12 serverless functions. Every /api/* endpoint is served by the
# single catch-all api/[...path].ts, so the individual per-endpoint files are excluded from the deploy.
#
# EVERY endpoint file must be listed here, and the dev middleware must import from server/ rather
# than from api/. api/ai-credits.ts was missing from this list, so it shipped as its own function
# that never passed through jsonRoute and answered the account balance to anyone who asked. It was
# also the only file vite.config imported out of api/, which is what hid the omission: a file listed
# here is deleted before the build, so such an import compiles locally and fails the deploy.
api/ai-credits.ts
api/ai-status.ts
api/claude-agent.ts
api/claude-ask.ts
api/coherence-check.ts
api/draft-cell.ts
api/draft-copy.ts
api/extract-copy.ts
api/flow-agent.ts
api/icp-review.ts
api/media-mix.ts
api/publish-email.ts
api/publish.ts
api/records-agent.ts

# Never bundle local secrets into a deploy — env vars are configured in the Vercel project.
.env
.env.*
